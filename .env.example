# ── Compose ─────────────────────────────────────────
COMPOSE_PROJECT_NAME=fitness

# ── Postgres container admin ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Mongo container admin ──
MONGO_ROOT_USER=mongo
MONGO_ROOT_PASSWORD=mongo

# ── user-service ──
USER_SERVICE_DB_HOST=postgres
USER_SERVICE_DB_PORT=5432
USER_SERVICE_DB_NAME=userdb
USER_SERVICE_DB_USER=user_service
USER_SERVICE_DB_PASSWORD=change_me

# ── activity-service ──
ACTIVITY_SERVICE_MONGO_URI=mongodb://mongo:mongo@mongodb:27017/activitydb?authSource=admin
ACTIVITY_SERVICE_DB_USER=activity_service
ACTIVITY_SERVICE_DB_PASSWORD=secret_here
ACTIVITY_SERVICE_DB_NAME=activitydb

# ── ai-service ──
AI_SERVICE_MONGO_URI=mongodb://mongo:mongo@mongodb:27017/recommendationdb?authSource=admin
AI_SERVICE_DB_USER=ai_service
AI_SERVICE_DB_PASSWORD=secret_here
AI_SERVICE_DB_NAME=recommendationdb

# ── Eureka ──
EUREKA_URL=http://eureka-server:8761/eureka/

# ── Config Server ──
CONFIG_SERVER_URL=http://config-server:8888

# ── Prod registry ──
DOCKER_REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# RabbitMQ container
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=rabbitmq

# Apps (Spring)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
RABBITMQ_VHOST=/

# Gemini API
GEMINI_API_URL=
GEMINI_API_KEY=

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak DB
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# keycloak JWT issuer
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/fitness-oauth2

# How apps reach Keycloak inside Docker
KEYCLOAK_URL=http://keycloak:8080

# Public URL (browser / redirects)
KEYCLOAK_HOSTNAME=http://localhost:8180
